{
  "name": "crescent-startup-lab-mysql",
  "version": "3.0.0",
  "private": true,
  "description": "Full-stack Crescent Startup Lab directory with React, Node/Express, secure JWT authentication, and populated MySQL database.",
  "homepage": ".",
  "dependencies": {
    "@craco/craco": "7.1.0",
    "ajv": "8.17.1",
    "ajv-keywords": "5.1.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "^18.0.4",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "express": "4.21.2",
    "framer-motion": "11.18.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.516.0",
    "morgan": "1.10.0",
    "mysql2": "3.11.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.30.1",
    "react-scripts": "5.0.1",
    "recharts": "3.6.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "nodemon": "3.1.9",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.17"
  },
  "scripts": {
    "start": "concurrently -k -n API,WEB -c green,cyan \"npm run server\" \"npm run client\"",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run server:watch\" \"npm run client\"",
    "client": "craco start",
    "server": "node server/index.js",
    "server:watch": "nodemon server/index.js",
    "db:setup": "node server/scripts/setupDatabase.js",
    "db:check": "node server/scripts/checkDatabase.js",
    "build": "craco build",
    "test": "craco test",
    "serve": "npx serve -s build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20 <23"
  }
}
