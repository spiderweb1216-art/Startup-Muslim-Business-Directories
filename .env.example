# LOCAL DEVELOPMENT ONLY
NODE_ENV=development

# XAMPP / local MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=startup_muslim_directory_local_v312
DB_CONNECTION_LIMIT=10
DB_CREATE_DATABASE=true
DB_AUTO_MIGRATE=false
DB_SEED_CONTENT=false

# Local Express API
API_PORT=5000
CLIENT_URL=http://localhost:3000
TRUST_PROXY=false
JSON_LIMIT=20mb
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# Local React frontend
REACT_APP_API_URL=http://localhost:5000/api

# Never enable this in production. It allows restoring public demo credentials.
ALLOW_DEMO_SEED=false
