# MySQL connection (XAMPP defaults use root with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crescent_startup_lab
DB_CONNECTION_LIMIT=10

# Node API
API_PORT=5000
CLIENT_URL=http://localhost:3000
JSON_LIMIT=20mb
JWT_SECRET=replace-this-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=7d

# React frontend
REACT_APP_API_URL=http://localhost:5000/api
