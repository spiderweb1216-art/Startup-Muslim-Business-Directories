# Add these values in Hostinger hPanel environment variables.
NODE_ENV=production

# Hostinger may provide PORT. API_PORT=3000 is the safe fallback for its Node.js runtime.
API_PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_HOSTINGER_DATABASE_USER
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DB_NAME=YOUR_HOSTINGER_DATABASE_NAME
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Your exact public app origin, without a trailing slash.
CLIENT_URL=https://directory.example.com
SUPPORT_EMAIL=hello@example.com
TRUST_PROXY=true
JSON_LIMIT=20mb

# Generate a unique 64+ character value. Never reuse the example text.
JWT_SECRET=PASTE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# React and API are served from the same Express application.
REACT_APP_API_URL=/api

# Safe first-deployment automation. The database itself must already exist in hPanel.
DB_AUTO_MIGRATE=true
DB_CREATE_DATABASE=false
DB_SEED_CONTENT=true

# Creates the first administrator only when this email does not already exist.
# Remove ADMIN_PASSWORD from hPanel after the administrator has been created and tested.
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=USE_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
ADMIN_COUNTRY=Pakistan
ADMIN_FORCE_UPDATE=false

# Keep false on every real production database.
ALLOW_DEMO_SEED=false
